# Private preview secrets and settings (T14b, S20) — the template of `deploy/preview.env`.
#
#   cp deploy/preview.env.example deploy/preview.env
#   chmod 600 deploy/preview.env        # it holds the SMTP app password
#   $EDITOR deploy/preview.env          # every placeholder below has to become a real value
#
# `deploy/preview.env` is gitignored and is only ever read by `--env-file` substitution in
# `compose.yaml` + `deploy/compose.preview.yaml` and by `deploy/preview.sh`. This example file is
# committed and must never hold a real secret.

# The public HTTPS URL the Funnel serves, with no trailing slash: magic links, alert links, the
# allowed browser origin, the canonical URLs and the sitemap all derive from it. Yours is printed by
# `deploy/preview.sh funnel-on` and by `tailscale funnel status`.
PREVIEW_URL=https://ubuntu-dev.tail3b8c9d.ts.net

# Loopback port Caddy listens on; the Funnel proxies this machine's 127.0.0.1:${WEB_PORT} to it.
WEB_PORT=4321

# Database and broker credentials. They are generated here and never leave this file; the users stay
# `rindetuplata`. Two different long random strings, for example: openssl rand -base64 24
POSTGRES_PASSWORD=replace-with-a-long-random-password
RABBITMQ_DEFAULT_PASS=replace-with-another-long-random-password

# Real SMTP: the preview sends magic links and alert emails to real inboxes, so Mailpit is off.
# Gmail needs 2-Step Verification and a 16-character App Password (not the account password):
# https://myaccount.google.com/apppasswords
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your.account@gmail.com
SPRING_MAIL_PASSWORD=replace-with-the-16-character-app-password

# Sender presented to readers (Gmail rewrites it to the authenticated account in practice).
RINDETUPLATA_MAIL_FROM="rindetuplata <your.account@gmail.com>"

# Comma-separated emails that get the admin role (/admin/tasas). Put yours first: the first login of
# an address creates its account, and only these addresses can curate wallet rates.
RINDETUPLATA_AUTH_ADMINEMAILS=your.account@gmail.com
