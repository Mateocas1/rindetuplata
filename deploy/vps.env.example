# Template of /srv/rindetuplata/api.env, the VPS env file (T4c, F2). Copy it, fill every value, chmod 600; the real
# file is root-only and never committed. docs/deploy.md ("VPS: the API") explains each key.
# Loads the `stack` profile (api, caddy) in every Compose command that reads this file: the drill, backup.sh and
# restore.sh run Compose with only --env-file, and without the profile Compose rejects the project ("service caddy
# depends on undefined service api"). Keep it.
COMPOSE_PROFILES=stack
POSTGRES_PASSWORD=change-me
RABBITMQ_DEFAULT_PASS=change-me
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_USERNAME=change-me
SPRING_MAIL_PASSWORD=change-me
RINDETUPLATA_AUTH_MAGICLINKURL=https://rindetuplata.ar/ingresar
RINDETUPLATA_ALERT_MANAGEURL=https://rindetuplata.ar/alertas
RINDETUPLATA_WEB_ALLOWEDORIGINS=https://rindetuplata.ar
RINDETUPLATA_AUTH_ADMINEMAILS=admin@example.com
RINDETUPLATA_INGEST_REBUILDHOOKURL=https://example.com/hook
