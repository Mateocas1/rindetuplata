# VPS: automatic TLS for the API, and nothing else published.
#
# The API container is only reachable from this Compose network; Caddy gets the certificate for
# api.<domain> from Let's Encrypt on its own. The site is static and lives on a CDN, so Caddy here
# serves the API only — the local one-origin Caddyfile lives in deploy/Caddyfile.local.
#
# Only the API's public routes are proxied: `/api/*`, the OpenAPI document `/v3/api-docs` and the MCP endpoint
# `/mcp` (all three named by llms.txt), plus exactly the two health URLs the external uptime monitor and
# the post-restore check read (F1: `/actuator/health` and `/actuator/health/ingestion`, never the rest of
# `/actuator/*`). The static site lives on the CDN, and a
# path that reaches this host by accident (a stale DNS record, a mistyped deploy URL) must answer 404
# instead of hitting whatever the API serves for it (finding R1 of review-d018a62efca39d30).

api.rindetuplata.ar {
	encode zstd gzip

	@api path /api/* /mcp /v3/api-docs /actuator/health /actuator/health/ingestion
	handle @api {
		reverse_proxy api:8080
	}

	handle {
		respond 404
	}
}
