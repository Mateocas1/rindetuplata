# Daily database backup: runs deploy/backup.sh once and exits. Triggered by rindetuplata-backup.timer.
#
# Install (docs/deploy.md, "Backups"): this assumes the checkout at /srv/rindetuplata; change
# WorkingDirectory and ExecStart if it lives elsewhere. Optional overrides (BACKUP_DIR,
# BACKUP_RETENTION_DAYS, BACKUP_COPY_COMMAND, ...) go in /srv/rindetuplata/backup.env, one KEY=value per line.
# Dumps go to /var/backups/rindetuplata (created 0700 by the script), outside the checkout, so cleaning the checkout
# and `docker build` never touch them.
[Unit]
Description=rindetuplata database backup (pg_dump through Docker Compose)
Documentation=file:///srv/rindetuplata/docs/deploy.md
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/srv/rindetuplata
EnvironmentFile=-/srv/rindetuplata/backup.env
ExecStart=/srv/rindetuplata/deploy/backup.sh
# A hung pg_dump must not pile up behind tomorrow's run.
TimeoutStartSec=30min
