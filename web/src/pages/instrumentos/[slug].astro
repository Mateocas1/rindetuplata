---
/**
 * Instrument page (T7c, S3, S10, S11).
 *
 * One page per instrument any prerendered table can link to (`lib/pages.ts`):
 * ranked or ineligible, never the unranked BCRA rows or the dead fund classes,
 * which would only ever be thin pages. Everything is rendered at build time: the
 * rate, its dates, its source and confidence, the history chart as an inline SVG
 * and the simulator island, which is the only client JavaScript on the page.
 */
import HistoryChart from '../../components/instrument/HistoryChart.astro';
import SimulatorIsland from '../../components/instrument/SimulatorIsland';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categoryForKind } from '../../lib/categories';
import { MissingHistoryRecording, loadHistory } from '../../lib/data';
import { formatDate, formatDays, formatMoney, formatPercent, formatSignedPercent } from '../../lib/format';
import {
  confidenceLabel,
  flagLabel,
  ineligibleExplanation,
  inflationIndexLabel,
  kindLabel,
  rateKindLabel,
} from '../../lib/labels';
import { loadInstrumentPages } from '../../lib/pages';
import { DEFAULT_AMOUNT, DEFAULT_DAYS } from '../../lib/rankingQuery';
import { breadcrumbJsonLd, financialProductJsonLd } from '../../lib/seo';
import { instrumentSlug } from '../../lib/slug';
import type { IneligibleEntry, Inflation, InstrumentHistory, RankedEntry } from '../../lib/types';

interface PageProps {
  entry: RankedEntry | IneligibleEntry;
  inflation: Inflation | null;
}

export async function getStaticPaths() {
  const pageSet = await loadInstrumentPages();
  return pageSet.pages.map(({ entry }) => ({
    params: { slug: instrumentSlug(entry.name, entry.id) },
    props: { entry, inflation: pageSet.inflation },
  }));
}

const { entry, inflation } = Astro.props as PageProps;
const ranked: RankedEntry | null = 'rateUsed' in entry ? entry : null;
const ineligible: IneligibleEntry | null = 'reason' in entry ? entry : null;

// A page exists for every instrument a table can link to, and in fixture mode
// not every one of those has a recorded history yet: the chart says so instead
// of failing the build. Any other read error still stops the build.
let history: InstrumentHistory | null = null;
try {
  history = await loadHistory(entry.id);
} catch (error) {
  if (!(error instanceof MissingHistoryRecording)) throw error;
}

const category = categoryForKind(entry.kind);

const site = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(Astro.url.pathname, site);
const kindName = kindLabel(entry.kind);
const basis = ranked === null ? null : ranked.rateUsed.basis;
const ratePercent = ranked === null ? null : formatPercent(ranked.rateUsed.fraction);
const inflationLabel =
  inflation === null ? 'sin dato de inflación' : inflationIndexLabel(inflation.index);

const title =
  basis !== null && ratePercent !== null
    ? `${entry.name} · ${kindName}: ${basis} ${ratePercent} | rindetuplata`
    : `${entry.name} · ${kindName} | rindetuplata`;
const description =
  ranked !== null
    ? `Cuánto rinde ${entry.name} hoy: ${basis} ${ratePercent} según ${entry.source.displayName}, dato del ${formatDate(entry.dataDate)}. Mirá el historial contra la inflación del INDEC y simulá con tu monto y tu plazo.`
    : `${entry.name} (${kindName}) no entra en el ranking de hoy. Mirá su historial contra la inflación del INDEC y las condiciones que pide.`;

/** One trail, one URL shape: every item ends in a slash like the canonical. */
const breadcrumb = [
  { name: 'Inicio', url: new URL('/', site).href },
  ...(category === null
    ? []
    : [{ name: category.navLabel, url: new URL(category.path, site).href }]),
  { name: entry.name, url: canonical.href },
];

const jsonLd: object[] = [breadcrumbJsonLd(breadcrumb)];
if (ranked !== null) {
  jsonLd.push(
    financialProductJsonLd({
      name: ranked.name,
      description: `${kindName}. Fuente: ${ranked.source.displayName}. Dato del ${formatDate(ranked.dataDate)}.`,
      url: canonical.href,
      interestRate: ranked.rateUsed.fraction,
      provider: ranked.entity,
    }),
  );
}

const isStale = ranked !== null && ranked.warnings.some((warning) => warning.code === 'STALE');

// The hero states today's fact the way the reference plate does: the pesos the
// default amount earns in the default term as the protagonist figure, the rate
// and its kind as data, and one quiet provenance line (L77). The simulator
// below turns that default into the reader's own amount and term.
const defaultMoney = formatMoney(DEFAULT_AMOUNT);
const defaultTerm = formatDays(DEFAULT_DAYS);
const inflationValue = inflation === null ? 'sin dato' : formatPercent(inflation.overHorizon);
const provenance = `${entry.source.displayName}${entry.source.official ? ' · fuente oficial' : ''} · dato del ${formatDate(entry.dataDate)}`;
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <article class="flex flex-col gap-section py-section">
    <header class="flex max-w-prose flex-col gap-block">
      <nav aria-label="Ubicación" class="type-label">
        <ol class="flex flex-wrap gap-x-2">
          <li>
            <a class="hover:text-text" href="/">
              Inicio
            </a>
          </li>
          {
            category !== null && (
              <li>
                <span aria-hidden="true">/</span>{' '}
                <a class="hover:text-text" href={category.path}>
                  {category.navLabel}
                </a>
              </li>
            )
          }
          <li aria-current="page"><span aria-hidden="true">/</span> {entry.name}</li>
        </ol>
      </nav>
      <div class="flex flex-col gap-block">
        <p class="type-label">
          {kindName}
          {ranked?.entity !== null && ranked?.entity !== undefined && ranked.entity !== ranked.name
            ? ` · ${ranked.entity}`
            : ''}
        </p>
        <h1 class="type-display max-w-prose">{entry.name}</h1>
      </div>

      {
        ranked !== null ? (
          <div class="card max-w-prose border-s-2 border-s-accent p-6">
            <p class="type-label">Hoy</p>
            <p class="type-figure mt-3">{formatMoney(ranked.earned)}</p>
            <p class="type-data text-muted mt-1">
              en {defaultTerm} con {defaultMoney}
            </p>
            <dl class="mt-5 grid grid-cols-2 gap-x-6 gap-y-4 border-t border-border pt-4 sm:grid-cols-3">
              <div>
                <dt class="type-label">{basis}</dt>
                <dd class="type-data">{ratePercent}</dd>
              </div>
              <div>
                <dt class="type-label">Rendimiento real</dt>
                <dd class="type-data">
                  {ranked.realReturn === null ? 'sin dato' : formatSignedPercent(ranked.realReturn)}
                </dd>
              </div>
              <div class="col-span-2 sm:col-span-1">
                <dt class="type-label">Inflación del plazo</dt>
                <dd class="type-data">{inflationValue}</dd>
              </div>
            </dl>
            <p class="type-data text-muted mt-4">{provenance}</p>
            {ranked.upTo !== null && (
              <p class="type-data text-warning mt-2">
                Hasta {formatMoney(ranked.upTo.finalAmount)} {ranked.upTo.condition}.
              </p>
            )}
            {isStale && (
              <p class="chip mt-3 self-start bg-warning-surface text-on-warning">
                {flagLabel('STALE')}: la fuente no publica un dato más nuevo.
              </p>
            )}
            <details class="disclosure mt-4">
              <summary class="type-label">De dónde sale este número</summary>
              <p class="type-body mt-2 max-w-prose text-muted">
                {rateKindLabel(ranked.rateUsed.kind)}. La fuente publica la tasa como {basis}; el
                ranking la usa para calcular cuánto ganás con tu monto y tu plazo. El dato se
                capturó el {formatDate(ranked.captureDate)} con una confianza de{' '}
                {confidenceLabel(ranked.confidence)}
                {ranked.verifiedAt !== null
                  ? `, verificada el ${formatDate(ranked.verifiedAt)}`
                  : ''}.
              </p>
            </details>
          </div>
        ) : (
          <div class="card max-w-prose p-6">
            <p class="type-label">Hoy no entra en el ranking</p>
            <p class="type-body mt-2 max-w-prose">
              {ineligible === null
                ? 'La API no lo puede rankear hoy.'
                : ineligibleExplanation(ineligible.reason, {
                    amount: DEFAULT_AMOUNT,
                    days: DEFAULT_DAYS,
                  })}
            </p>
            <p class="type-data text-muted mt-3">
              {provenance}
              {ineligible !== null ? ` · captura del ${formatDate(ineligible.captureDate)}` : ''}
            </p>
          </div>
        )
      }
    </header>

    <section class="flex flex-col gap-block" aria-labelledby="historial">
      <div class="flex flex-col gap-2">
        <h2 id="historial" class="type-section">Cómo viene rindiendo</h2>
        <p class="type-data text-muted">Tasa anual contra IPC mensual del INDEC</p>
      </div>
      <HistoryChart history={history} />
    </section>

    <section class="flex max-w-prose flex-col gap-block" aria-labelledby="simulador">
      <div class="flex flex-col gap-2">
        <h2 id="simulador" class="type-section">Simulá con tu monto y tu plazo</h2>
        <p class="type-data text-muted">
          Rendimiento real contra la inflación esperada del {inflationLabel}
        </p>
      </div>
      <SimulatorIsland
        client:visible
        instrumentId={entry.id}
        inflationIndexLabel={inflationLabel}
      />
    </section>

    <footer class="flex max-w-prose flex-col gap-2 border-t border-border pt-block">
      <p class="type-body">
        {
          category !== null && (
            <>
              <a class="link" href={category.path}>
                Ver {category.navLabel.toLowerCase()}
              </a>{' '}
              ·{' '}
            </>
          )
        }
        <a class="link" href="/metodologia/">
          Cómo se calcula cada número
        </a>
      </p>
      <p class="type-data text-muted">
        Es información, no asesoramiento financiero. rindetuplata no recibe dinero de las entidades
        que compara.
      </p>
    </footer>
  </article>
</BaseLayout>
