---
/**
 * One monthly report (T6a, S6, L29 a): "Quién le ganó a la inflación en <mes>". The table of every option measured over
 * the closed month, sorted by real return, the INDEC rate it is measured against with its source and date, the options
 * left out with their reason, and the method in two sentences. One static page per month the API lists.
 */
import LeftOutList from '../../components/report/LeftOutList.astro';
import ReportTable from '../../components/report/ReportTable.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, formatPercent } from '../../lib/format';
import { loadMonthlyReports, monthLabel, REPORTS_PATH, type MonthlyReport } from '../../lib/reports';
import { breadcrumbJsonLd } from '../../lib/seo';

export async function getStaticPaths() {
  const reports = await loadMonthlyReports();
  return reports.map((report) => ({ params: { month: report.month }, props: { report } }));
}

const { report } = Astro.props as { report: MonthlyReport };
const month = monthLabel(report.month);
const inflation = formatPercent(report.inflation.value);
const options = report.totals.ranked === 1 ? 'opción' : 'opciones';

const site = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(Astro.url.pathname, site);
const jsonLd = breadcrumbJsonLd([
  { name: 'Inicio', url: new URL('/', site).href },
  { name: 'Informes', url: new URL(REPORTS_PATH, site).href },
  { name: month, url: canonical.href },
]);

const linkClass =
  'text-text underline decoration-border-strong underline-offset-2 hover:decoration-text';
---

<BaseLayout
  title={`Quién le ganó a la inflación en ${month} | rindetuplata`}
  description={`Cuánto rindió cada plazo fijo, billetera, fondo y cripto en ${month} contra la inflación del INDEC (${inflation}): ${report.totals.beatInflation} de ${report.totals.ranked} ${options} le ganaron.`}
  jsonLd={jsonLd}
>
  <article class="flex flex-col gap-section py-section">
    <header class="flex max-w-prose flex-col gap-block">
      <nav aria-label="Ubicación" class="type-label">
        <ol class="flex flex-wrap items-center gap-x-2">
          <li>
            <a class={linkClass} href="/">Inicio</a>
          </li>
          <li>
            <span aria-hidden="true">/</span>{' '}
            <a class={linkClass} href={REPORTS_PATH}>Informes</a>
          </li>
          <li aria-current="page"><span aria-hidden="true">/</span> {month}</li>
        </ol>
      </nav>
      <h1 class="type-display">Quién le ganó a la inflación en {month}</h1>
      <div class="card max-w-prose border-s-2 border-s-accent p-6">
        <p class="type-label">Inflación de {month}</p>
        <p class="type-figure mt-3">{inflation}</p>
        <p class="type-data text-muted mt-1">
          IPC mensual del INDEC, según {report.inflation.source.displayName} · dato del {formatDate(report.inflation.observationDate)}
        </p>
        <p class="type-body mt-4">
          {report.totals.beatInflation === 0
            ? `Ninguna de las ${report.totals.ranked} ${options} que pudimos medir le ganó a la inflación.`
            : `${report.totals.beatInflation === 1 ? 'Le ganó' : 'Le ganaron'} a la inflación ${report.totals.beatInflation} de las ${report.totals.ranked} ${options} que pudimos medir.`}
        </p>
      </div>
    </header>

    <section class="flex flex-col gap-block" aria-labelledby="tabla">
      <h2 id="tabla" class="type-section">Cómo le fue a cada opción</h2>
      <ReportTable report={report} />
      <LeftOutList leftOut={report.leftOut} />
    </section>

    <section class="flex max-w-prose flex-col gap-block" aria-labelledby="metodo">
      <h2 id="metodo" class="type-section">Cómo medimos</h2>
      <p class="type-body">
        Tomamos lo que cada opción rindió de verdad durante {month} con las tasas y cotizaciones que
        guardamos día a día: las billeteras y la cripto capitalizan cada día a su tasa vigente (la base, sin topes de saldo), el plazo
        fijo toma la tasa del primer día hábil del mes y los fondos, la variación de la cuotaparte entre
        un cierre de mes y el siguiente. El resultado real es (1 + rendimiento) / (1 + inflación del mes)
        − 1, y "le ganó" quiere decir que da más que cero; una opción sin datos suficientes en todo el
        mes queda fuera y figura aparte.
      </p>
      <p class="type-body">
        <a class={linkClass} href="/metodologia/">Cómo se calcula cada número</a>
        {' '}· <a class={linkClass} href={REPORTS_PATH}>Todos los informes</a>
      </p>
    </section>

    <footer class="flex max-w-prose flex-col gap-2 border-t border-border pt-block">
      <p class="type-data text-muted">
        Esto es información y no es asesoramiento financiero: lo que rindió una opción en el pasado no
        garantiza que lo repita. rindetuplata no recibe dinero de las entidades que compara.
      </p>
    </footer>
  </article>
</BaseLayout>
