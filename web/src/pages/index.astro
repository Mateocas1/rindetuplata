---
/**
 * Home: the ranking for the default amount and term, rendered at
 * build time from the API (or the recorded fixtures with WEB_FIXTURES=1) and
 * taken over by the RankingExplorer island once it hydrates.
 *
 * The H1 stays the question (ui-clarity D15); the island answers it in one
 * sentence right under the lead. The lead says once how the board is ordered;
 * the data date is the one quiet line above the H1, and the footer carries the
 * one disclaimer (D11).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import RankingExplorer from '../components/ranking/RankingExplorer';
import { loadBanks, loadRanking } from '../lib/data';
import { formatDate } from '../lib/format';
import { loadInstrumentPages } from '../lib/pages';
import { DEFAULT_RANKING_QUERY } from '../lib/rankingQuery';

const ranking = await loadRanking(DEFAULT_RANKING_QUERY);
const banks = await loadBanks();
// The island can ask for a combination nobody prerendered, so it needs to know
// which instrument pages exist before it renders a link (D1).
const pages = await loadInstrumentPages();

const dataDate = ranking.request.asOf;
const title = '¿Dónde rinde tu plata hoy? Comparador de plazos fijos y billeteras';
const description = `Mirá cuánto ganás con tu monto y tu plazo en plazos fijos, billeteras remuneradas, fondos money market y cripto, y cuánto le ganás a la inflación esperada. Datos del ${formatDate(dataDate)}.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'rindetuplata',
  url: (Astro.site ?? new URL('http://localhost:4321')).href,
  inLanguage: 'es-AR',
  description,
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  {/* Header to answer is one block (gap-block): the island opens with the answer sentence right under the
      lead (D15) and keeps its own section rhythm after it. */}
  <div class="flex flex-col gap-block py-section">
    <header class="flex max-w-prose flex-col gap-block">
      <p class="type-label">Comparador · datos del {formatDate(dataDate)}</p>
      <h1 class="type-display">¿Dónde rinde tu plata hoy?</h1>
      <p class="type-body text-lead text-muted">
        Plazos fijos, billeteras remuneradas, fondos money market y cripto, ordenados por los pesos
        que ganás con tu monto y tu plazo, no por la tasa.
      </p>
    </header>

    <RankingExplorer
      client:idle
      initialRanking={ranking}
      initialQuery={DEFAULT_RANKING_QUERY}
      banks={banks}
      pageSlugs={pages.slugs}
    />
  </div>
</BaseLayout>
