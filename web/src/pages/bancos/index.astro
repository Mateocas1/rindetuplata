---
/**
 * Bank index: every bank with a plazo fijo rate today, highest non-client TNA first, each linking its
 * entity page; the banks whose last rate is older than their source's newest capture follow, apart, with that rate's
 * date. Static tables with no island; the numbers are the API's own and the source and date are stated.
 */
import BankRatesTable from '../../components/BankRatesTable.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadBankList, splitBanksByFreshness, sourceName } from '../../lib/entities';
import { formatDate } from '../../lib/format';
import { breadcrumbJsonLd } from '../../lib/seo';

const all = await loadBankList();
// "Hoy" is only said of the banks with their source's newest rates; the others are listed after them, apart.
const { current: banks, previous } = splitBanksByFreshness(all);
const latest = banks.reduce((date, bank) => (bank.dataDate > date ? bank.dataDate : date), '');
const namesOf = (list: typeof all) => [...new Set(list.map((bank) => sourceName(bank.sourceId)))].join(', ');
const sources = namesOf(banks);

const site = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(Astro.url.pathname, site);
const title = 'Plazo fijo por banco: la tasa de hoy de cada uno | rindetuplata';
const description =
  `Cuánto paga hoy cada banco por un plazo fijo, para no clientes y para clientes, con la fuente y la fecha de cada dato. Entrá a un banco para ver sus últimos 90 días${latest === '' ? '' : ` (datos del ${formatDate(latest)})`}.`;
const jsonLd = breadcrumbJsonLd([
  { name: 'Inicio', url: new URL('/', site).href },
  { name: 'Bancos', url: canonical.href },
]);

const crumbClass = 'hover:text-text hover:underline focus-visible:underline underline-offset-2';
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="flex flex-col gap-section py-section">
    <header class="flex max-w-prose flex-col gap-block">
      <nav aria-label="Ubicación" class="type-label">
        <ol class="flex flex-wrap items-center gap-x-2">
          <li>
            <a class={crumbClass} href="/">Inicio</a>
          </li>
          <li aria-current="page"><span aria-hidden="true">/</span> Bancos</li>
        </ol>
      </nav>
      <h1 class="type-display">Cada banco y su plazo fijo de hoy</h1>
      <p class="type-body text-lead text-muted">
        Lo que paga hoy cada banco por un plazo fijo a quien no es cliente, de mayor a menor. Entrá
        a un banco para ver cómo viene su tasa en los últimos 90 días y cuántos de esos días fue la
        mejor.
      </p>
      {
        latest !== '' && (
          <p class="type-data text-muted">
            {sources} · dato del {formatDate(latest)}
          </p>
        )
      }
    </header>

    <section class="flex flex-col gap-block" aria-labelledby="bancos-de-hoy">
      <h2 id="bancos-de-hoy" class="type-section">Las tasas de hoy</h2>
      {
        all.length === 0 ? (
          <div class="card max-w-prose p-6">
            <p class="type-body font-semibold">Todavía no hay tasas por banco</p>
            <p class="type-body mt-2">
              Los datos se capturan una vez por día; apenas haya una captura, los bancos aparecen
              acá.
            </p>
          </div>
        ) : (
          <BankRatesTable
            banks={banks}
            regionLabel="Tasas de plazo fijo por banco"
            caption="Tasa nominal anual (TNA) de plazo fijo de cada banco para no clientes y para clientes."
          />
        )
      }
    </section>

    {
      previous.length > 0 && (
        <section class="flex flex-col gap-block" aria-labelledby="bancos-anteriores">
          <div class="flex max-w-prose flex-col gap-2">
            <h2 id="bancos-anteriores" class="type-section">
              Última tasa publicada
            </h2>
            <p class="type-data text-muted">
              {namesOf(previous)} no trajo a estos bancos en su última captura. Mostramos la última tasa que
              vimos de cada uno y de qué fecha es.
            </p>
          </div>
          <BankRatesTable
            banks={previous}
            showDate
            regionLabel="Última tasa publicada por banco"
            caption="Última tasa nominal anual (TNA) de plazo fijo publicada por los bancos que la fuente no trajo en su última captura, con la fecha de esa tasa."
          />
        </section>
      )
    }

    <p class="type-data text-muted">
      Mirá{' '}
      <a class="link" href="/plazo-fijo/">
        los plazos fijos ordenados por lo que ganás con tu monto y tu plazo
      </a>
      {' '}o cómo{' '}
      <a class="link" href="/metodologia/">
        se calcula cada número
      </a>
      .
    </p>
  </div>
</BaseLayout>
