---
/**
 * 404 (T7b, T13c): one line at the display role and one way back to the
 * ranking. The title and description still explain the page to a search
 * engine, but the page itself states the one fact and the one next step.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="No encontramos esta página | rindetuplata"
  description="La página que buscás no existe o cambió de dirección. Volvé al ranking de hoy o mirá cómo calculamos cada número."
  noindex
>
  <div class="flex max-w-prose flex-col gap-section py-section">
    <h1 class="type-display">No encontramos esta página</h1>
    <a class="link self-start type-body" href="/">Ver el ranking de hoy</a>
  </div>
</BaseLayout>
