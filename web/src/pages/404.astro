---
/**
 * 404: the fact at the display role, one sentence of reading text and the one way back,
 * the view's single primary action. The title and description still explain the page to a search engine.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="No encontramos esta página | rindetuplata"
  description="La página que buscás no existe o cambió de dirección. Volvé al ranking de hoy o mirá cómo calculamos cada número."
  noindex
>
  <div class="flex max-w-prose flex-col items-start gap-block py-section-lg">
    <h1 class="type-display">No encontramos esta página</h1>
    <p class="type-body text-lead text-muted">
      La dirección no existe o cambió. Volvé al ranking de hoy o mirá cómo calculamos cada número.
    </p>
    <div class="mt-2 flex flex-wrap items-center gap-x-6 gap-y-3">
      <a class="btn-primary" href="/">Ver el ranking de hoy</a>
      <a class="link type-body" href="/metodologia/">Cómo se calcula cada número</a>
    </div>
  </div>
</BaseLayout>
