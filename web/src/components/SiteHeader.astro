---
/**
 * Site chrome: a sticky header with the wordmark and the public pages (the
 * ranking, the four category landings and the methodology page). The height
 * (3.5rem) must stay in sync with `scroll-padding-block-start` in global.css so
 * anchors and focused elements never land under it. On narrow screens the nav
 * scrolls sideways rather than wrapping, so the header height never changes; its
 * trailing edge fades as a scroll cue, and its links draw an inset focus ring the
 * scroller cannot clip (T12e).
 *
 * T13b (Cobalto Cristal): the wordmark is set in the display family, the nav is
 * the mono caps `type-label` role separated by whitespace and one hairline under
 * the band, and the current page is marked twice — `aria-current` for assistive
 * technology and an ink bar under the link (a shape, so the state never depends
 * on colour alone). The bar is ink, not cobalt: on this site cobalt marks the
 * day's leader and the serif "plata" of the headline, one job per viewport.
 */
import { CATEGORIES } from '../lib/categories';

/** Trailing slashes are optional in a URL, so compare the paths without them. */
function normalizedPath(path: string): string {
  return path.replace(/\/+$/, '') || '/';
}

const current = normalizedPath(Astro.url.pathname);
const links = [
  { href: '/', label: 'Ranking' },
  ...CATEGORIES.map((category) => ({ href: category.path, label: category.navLabel })),
  { href: '/metodologia/', label: 'Cómo se calcula' },
];
---

<header class="sticky top-0 z-10 border-b border-border bg-surface">
  <div
    class="mx-auto flex h-14 w-full max-w-page items-center gap-4 px-gutter"
  >
    <a
      href="/"
      class="shrink-0 font-display text-body font-medium tracking-tight text-text no-underline"
    >
      rindetuplata
    </a>
    <nav
      aria-label="Secciones"
      class="min-w-0 flex-1 overflow-x-auto [mask-image:linear-gradient(to_left,transparent,black_2rem)] sm:[mask-image:none]"
    >
      <ul class="flex items-center gap-2 pe-8 whitespace-nowrap sm:gap-4 sm:pe-0">
        {
          links.map((link) => {
            const active = current === normalizedPath(link.href);
            return (
              <li>
                <a
                  href={link.href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'type-label relative block py-2 no-underline focus-visible:-outline-offset-2',
                    active ? 'text-text' : 'hover:text-text',
                  ]}
                >
                  {link.label}
                  {active && (
                    <span aria-hidden="true" class="absolute inset-x-0 bottom-0 h-0.5 bg-text" />
                  )}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
