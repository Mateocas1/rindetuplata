---
/**
 * Site chrome: a sticky header with the wordmark and the public pages (the
 * ranking, the four category landings and the methodology page). The height
 * (3.5rem) must stay in sync with `scroll-padding-block-start` in global.css so
 * anchors and focused elements never land under it. On narrow screens the nav
 * scrolls sideways rather than wrapping, so the header height never changes.
 */
import { CATEGORIES } from '../lib/categories';

/** Trailing slashes are optional in a URL, so compare the paths without them. */
function normalizedPath(path: string): string {
  return path.replace(/\/+$/, '') || '/';
}

const current = normalizedPath(Astro.url.pathname);
const links = [
  { href: '/', label: 'Ranking' },
  ...CATEGORIES.map((category) => ({ href: category.path, label: category.navLabel })),
  { href: '/metodologia/', label: 'Cómo se calcula' },
];
---

<header class="sticky top-0 z-10 border-b border-border bg-surface-raised">
  <div
    class="mx-auto flex h-14 w-full max-w-page items-center gap-4 px-gutter"
  >
    <a
      href="/"
      class="shrink-0 rounded-sm text-body-sm font-semibold tracking-tight text-text no-underline"
    >
      rindetuplata
    </a>
    <nav aria-label="Secciones" class="min-w-0 flex-1 overflow-x-auto">
      <ul class="flex items-center gap-1 whitespace-nowrap sm:gap-2">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={current === normalizedPath(link.href) ? 'page' : undefined}
                class="block rounded-sm px-2 py-2 text-body-sm no-underline aria-[current=page]:font-semibold"
                class:list={[
                  current === normalizedPath(link.href) ? 'text-text' : 'text-muted hover:text-text',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
