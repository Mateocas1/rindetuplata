---
/**
 * Instrument history chart (T7c, S10, S14).
 *
 * Rendered at build time as an inline SVG: no island, no client JavaScript. The
 * geometry comes from `lib/chart.ts`; this component only draws it and repeats
 * every number in a real table, so a reader without the SVG (or with a screen
 * reader) still gets the data. The legend uses stroke pattern and marker shape,
 * so the two series are told apart without relying on colour.
 */
import { buildChart, seriesFromHistory, type ChartSeriesInput } from '../../lib/chart';
import { formatDate, formatInteger, formatPercent } from '../../lib/format';
import type { InstrumentHistory } from '../../lib/types';

export interface Props {
  /** Null when nothing was recorded for this instrument yet: the chart says so. */
  history: InstrumentHistory | null;
}

const { history } = Astro.props;
const series = history === null ? [] : seriesFromHistory(history);
const chart = history === null ? null : buildChart({ series });
// Empty when nothing was recorded, so every use below is optional.
const rateSeries: ChartSeriesInput | undefined = series[0];
const inflationSeries: ChartSeriesInput | undefined = series[1];
const titleId = `chart-title-${history?.id ?? 'sin-historial'}`;
const descId = `chart-desc-${history?.id ?? 'sin-historial'}`;

/** One row per date any series has, so the two series can be compared. */
const dates = [...new Set(series.flatMap((entry) => entry.points.map((point) => point.date)))].sort();
const rows = dates.map((date) => ({
  date,
  rate: rateSeries?.points.find((point) => point.date === date)?.value ?? null,
  inflation: inflationSeries?.points.find((point) => point.date === date)?.value ?? null,
}));

const ratePointCount = rateSeries?.points.length ?? 0;
const rateColor = 'text-accent';
const inflationColor = 'text-muted';const description =
  history === null || rateSeries === undefined || inflationSeries === undefined
    ? ''
    : `${rateSeries.label} y ${inflationSeries.label} de ${history.displayName} ` +
      `entre el ${formatDate(history.from)} y el ${formatDate(history.to)}. ` +
      `La tasa es anual y la inflación es la variación del mes; los dos valores comparten la escala de porcentaje.`;
---

<figure class="flex flex-col gap-3">
  {
    chart !== null && chart.hasData && history !== null && rateSeries !== undefined && inflationSeries !== undefined ? (
      <>
        <p class="type-data text-muted md:hidden">
          Deslizá el gráfico para ver todo el período.
        </p>
        {/*
          The chart is drawn at its intrinsic pixel size (T12b): a viewBox that
          scaled with the container would scale the axis labels with it, from a
          legible 13px (`type-data`) down to single digits on a phone. Fixed
          pixels plus a labelled scroll region keeps every label at its token
          size on every screen.
        */}
        <div
          class="card flex w-fit max-w-full flex-row-reverse overflow-x-auto p-block focus-visible:-outline-offset-2"
          role="region"
          aria-label={`Gráfico: ${rateSeries.label} contra ${inflationSeries.label}`}
          tabindex="0"
        >
          <svg
            width={chart.width}
            height={chart.height}
            viewBox={`0 0 ${chart.width} ${chart.height}`}
            class="block shrink-0"
            role="img"
            aria-labelledby={`${titleId} ${descId}`}
          >
            <title id={titleId}>{`${rateSeries.label} contra ${inflationSeries.label}`}</title>
            <desc id={descId}>{description}</desc>

            {chart.yTicks.map((tick) => (
              <g>
                <line
                  x1={chart.plot.x0}
                  x2={chart.plot.x1}
                  y1={tick.position}
                  y2={tick.position}
                  class="stroke-border"
                  stroke-width="1"
                />
                <text
                  x={chart.plot.x0 - 8}
                  y={tick.position + 3}
                  text-anchor="end"
                  class="fill-muted type-data"
                >
                  {tick.label}
                </text>
              </g>
            ))}

            {chart.xTicks.map((tick) => (
              <text
                x={tick.position}
                y={chart.plot.y1 + 18}
                text-anchor="middle"
                class="fill-muted type-data"
              >
                {tick.label}
              </text>
            ))}

            <line
              x1={chart.plot.x0}
              x2={chart.plot.x1}
              y1={chart.plot.y1}
              y2={chart.plot.y1}
              class="stroke-border-strong"
              stroke-width="1"
            />

            {chart.series.map((entry, index) => (
              <g class={index === 0 ? rateColor : inflationColor}>
                {entry.path !== '' && (
                  <path
                    d={entry.path}
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linejoin="round"
                    stroke-linecap="round"
                    stroke-dasharray={entry.dashed ? '6 5' : undefined}
                  />
                )}
                {entry.points.map((point) =>
                  entry.marker === 'square' ? (
                    <rect
                      x={point.x - 3}
                      y={point.y - 3}
                      width="6"
                      height="6"
                      fill="currentColor"
                    />
                  ) : (
                    <circle cx={point.x} cy={point.y} r="3.5" fill="currentColor" />
                  ),
                )}
              </g>
            ))}
          </svg>
        </div>

        <ul class="flex flex-wrap gap-x-6 gap-y-2">
          {chart.series.map((entry, index) => (
            <li class="flex items-center gap-2">
              <svg viewBox="0 0 32 12" width="32" height="12" aria-hidden="true" class={`shrink-0 ${index === 0 ? rateColor : inflationColor}`}>
                <line
                  x1="0"
                  y1="6"
                  x2="32"
                  y2="6"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-dasharray={entry.dashed ? '6 5' : undefined}
                />
                {entry.marker === 'square' ? (
                  <rect x="13" y="3" width="6" height="6" fill="currentColor" />
                ) : (
                  <circle cx="16" cy="6" r="3.5" fill="currentColor" />
                )}
              </svg>
              <span class="type-data">
                {entry.label}
                <span class="text-muted">
                  {entry.dashed ? ' · línea punteada y cuadrados' : ' · línea llena y círculos'}
                </span>
              </span>
            </li>
          ))}
        </ul>

        <p class="type-body max-w-prose text-muted">
          La tasa es anual y cada punto de inflación es la variación mensual del IPC del INDEC.
        </p>

        <details class="disclosure card px-4 py-3">
          <summary class="type-label hover:text-text">
            Ver los datos del gráfico en una tabla
          </summary>
          <div class="mt-2 overflow-x-auto">
            <table class="w-full min-w-[28rem] border-separate border-spacing-0">
              <caption class="sr-only">
                {rateSeries.label} y {inflationSeries.label} de {history.displayName}, fecha por
                fecha. Los mismos datos que muestra el gráfico.
              </caption>
              <thead>
                <tr>
                  <th scope="col" class="type-label border-b border-border px-3 py-2 text-start">
                    Fecha
                  </th>
                  <th scope="col" class="type-label border-b border-border px-3 py-2 text-end">
                    {rateSeries.label}
                  </th>
                  <th scope="col" class="type-label border-b border-border px-3 py-2 text-end">
                    {inflationSeries.label}
                  </th>
                </tr>
              </thead>
              <tbody>
                {rows.map((row) => (
                  <tr>
                    <th scope="row" class="type-data border-b border-border px-3 py-2 text-start font-normal">
                      {formatDate(row.date)}
                    </th>
                    <td class="type-data border-b border-border px-3 py-2 text-end">
                      {row.rate === null ? '—' : formatPercent(row.rate)}
                    </td>
                    <td class="type-data border-b border-border px-3 py-2 text-end">
                      {row.inflation === null ? '—' : formatPercent(row.inflation)}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="type-data text-muted mt-3">
            El histórico se arma con una ingesta diaria: hay {formatInteger(ratePointCount)}{' '}
            {ratePointCount === 1 ? 'registro de tasa' : 'registros de tasa'} entre el{' '}
            {formatDate(history.from)} y el {formatDate(history.to)}.
          </p>
        </details>
      </>
    ) : (
      <div class="card max-w-prose p-6">
        <p class="type-label">Todavía no hay historial para este instrumento</p>
        <p class="type-body mt-2 max-w-prose">
          El histórico se arma con una ingesta diaria y todavía no hay fechas para comparar.
          Mientras tanto, arriba están la tasa y las condiciones de hoy.
        </p>
      </div>
    )
  }
</figure>
