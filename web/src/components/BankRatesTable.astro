---
/**
 * The bank table of `/bancos/` (T6b, S6; T10a): one row per bank with its non-client and client TNA, each linking
 * its page. `showDate` adds the capture date of the rate, for banks whose last rate is older than their source's
 * newest capture. A static table with no island.
 */
import { formatDate, formatPercent } from '../lib/format';

interface Props {
  banks: Array<{
    slug: string;
    name: string;
    nonClientTna: number | null;
    clientTna: number | null;
    captureDate: string;
  }>;
  /** Visually hidden table caption, which is also the accessible name of the scrollable region. */
  caption: string;
  regionLabel: string;
  showDate?: boolean;
}

const { banks, caption, regionLabel, showDate = false } = Astro.props;

const linkClass =
  'text-text underline decoration-border-strong underline-offset-2 hover:decoration-text';
const cell = 'type-data border-b border-border px-3 py-2';
---

<div
  class="card relative overflow-x-auto focus-visible:-outline-offset-2"
  role="region"
  aria-label={regionLabel}
  tabindex="0"
>
  <table class="w-full min-w-[32rem] border-separate border-spacing-0">
    <caption class="sr-only">{caption}</caption>
    <thead>
      <tr>
        <th scope="col" class="type-label border-b border-border px-3 py-2 text-start">Banco</th>
        <th scope="col" class="type-label border-b border-border px-3 py-2 text-end">
          TNA no clientes
        </th>
        <th scope="col" class="type-label border-b border-border px-3 py-2 text-end">
          TNA clientes
        </th>
        {
          showDate && (
            <th scope="col" class="type-label border-b border-border px-3 py-2 text-end">
              Tasa del
            </th>
          )
        }
      </tr>
    </thead>
    <tbody>
      {
        banks.map((bank) => (
          <tr>
            <th scope="row" class={`${cell} text-start font-normal`}>
              <a class={linkClass} href={`/bancos/${bank.slug}/`}>
                {bank.name}
              </a>
            </th>
            <td class={`${cell} text-end`}>
              {bank.nonClientTna === null ? (
                <span class="text-muted">No ofrece a no clientes</span>
              ) : (
                formatPercent(bank.nonClientTna)
              )}
            </td>
            <td class={`${cell} text-end`}>
              {bank.clientTna === null ? '—' : formatPercent(bank.clientTna)}
            </td>
            {showDate && <td class={`${cell} text-end`}>{formatDate(bank.captureDate)}</td>}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
