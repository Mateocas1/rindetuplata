---
/**
 * The bank table of `/bancos/`: one row per bank with its non-client and client TNA,
 * each linking its page. Bank names go through `displayName` and read in the body role; the link is quiet at rest and
 * underlined on hover and keyboard focus. Numbers are right-aligned and tabular. `showDate` adds the capture date of
 * the rate, for banks whose last rate is older than their source's newest capture. A static table with no island.
 */
import { displayName } from '../lib/displayName';
import { formatDate, formatPercent } from '../lib/format';

interface Props {
  banks: Array<{
    slug: string;
    name: string;
    nonClientTna: number | null;
    clientTna: number | null;
    captureDate: string;
  }>;
  /** Visually hidden table caption, which is also the accessible name of the scrollable region. */
  caption: string;
  regionLabel: string;
  showDate?: boolean;
}

const { banks, caption, regionLabel, showDate = false } = Astro.props;

const cell = 'border-b border-border px-3 py-3 align-baseline';
const headCell = 'type-label border-b border-border px-3 py-3 align-bottom';
---

<div
  class="card relative overflow-x-auto focus-visible:-outline-offset-2"
  role="region"
  aria-label={regionLabel}
  tabindex="0"
>
  <table class="w-full border-separate border-spacing-0">
    <caption class="sr-only">{caption}</caption>
    <thead>
      <tr>
        <th scope="col" class={`${headCell} text-start`}>Banco</th>
        <th scope="col" class={`${headCell} text-end`}>TNA no clientes</th>
        <th scope="col" class={`${headCell} text-end`}>TNA clientes</th>
        {showDate && <th scope="col" class={`${headCell} text-end`}>Tasa del</th>}
      </tr>
    </thead>
    <tbody class="[&>tr:last-child>*]:border-b-0">
      {
        banks.map((bank) => (
          <tr class="hover:bg-subtle-surface">
            <th scope="row" class={`${cell} type-body text-start font-medium`}>
              <a
                class="text-text underline-offset-2 hover:underline focus-visible:underline"
                href={`/bancos/${bank.slug}/`}
              >
                {displayName(bank.name)}
              </a>
            </th>
            <td class={`${cell} type-data text-end`}>
              {bank.nonClientTna === null ? (
                <span class="text-muted">No ofrece</span>
              ) : (
                formatPercent(bank.nonClientTna)
              )}
            </td>
            <td class={`${cell} type-data text-end`}>
              {bank.clientTna === null ? '—' : formatPercent(bank.clientTna)}
            </td>
            {showDate && <td class={`${cell} type-data text-end`}>{formatDate(bank.captureDate)}</td>}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
