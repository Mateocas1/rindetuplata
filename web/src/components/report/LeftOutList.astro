---
/**
 * The options a month's report could not measure, each with its reason in Spanish (S15: nothing is dropped silently).
 * Collapsed by default so the table keeps the page.
 */
import { displayName } from '../../lib/displayName';
import { kindLabel } from '../../lib/labels';
import { leftOutReasonLabel, type ReportLeftOut } from '../../lib/reports';

export interface Props {
  leftOut: ReportLeftOut[];
}

const { leftOut } = Astro.props;
---

{
  leftOut.length > 0 && (
    <details class="disclosure card max-w-prose px-4 py-3">
      <summary class="type-label hover:text-text">
        Opciones que no pudimos medir ({leftOut.length})
      </summary>
      <ul class="mt-3 flex flex-col gap-3">
        {leftOut.map((left) => (
          <li>
            <span class="block type-body font-medium">{displayName(left.name)}</span>
            <span class="block type-data text-muted">
              {kindLabel(left.kind)} · {leftOutReasonLabel(left.reason)}
            </span>
          </li>
        ))}
      </ul>
    </details>
  )
}
